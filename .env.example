POSTGRES_DB=oficina_execution
POSTGRES_USER=sa
POSTGRES_PASSWORD=P@ssw0rd123
POSTGRES_PORT=5435

API_EXECUTION_PORT=7197
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

ALLOWED_HOSTS=*
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_ASPNETCORE=Warning
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=oficina_execution;Username=sa;Password=P@ssw0rd123

ELASTICMQ_PORT=9327
# Saga local com a Management, o OS Service e o Billing: os servicos precisam do mesmo ElasticMQ (o da Management).
# Use SQS_SERVICE_URL=http://oficina-elasticmq:9324 e, depois do "compose up", ligue o container a rede da Management:
#   podman network connect tech-challenge-fase-4-management-soat16-rm374658_default oficina-execution-api
SQS_SERVICE_URL=http://elasticmq:9324

# DynamoDB local (linha do tempo da producao); a API cria a tabela ao subir. 8001 para nao conflitar com o DynamoDB local do Billing (8000)
DYNAMODB_PORT=8001

REGISTRY_PREFIX=903936907231.dkr.ecr.us-east-1.amazonaws.com/
IMAGE_TAG=latest
