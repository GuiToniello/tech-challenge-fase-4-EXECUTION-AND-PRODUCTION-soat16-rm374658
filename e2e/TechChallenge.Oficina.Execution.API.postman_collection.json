{
  "info": {
    "_postman_id": "e89f1097-16f5-4e84-9d84-354635ad472b",
    "name": "TechChallenge Oficina Execution API",
    "description": "Colecao do Execution (execucao e producao): fila da oficina, diagnostico, inicio e fim da execucao, alimentados pela saga com a Management e o OS Service (SQS). Local: baseUrl http://localhost:7197, osBaseUrl http://localhost:7195, managementBaseUrl http://localhost:7194 e billingBaseUrl http://localhost:7196. AWS: use o environment AWS (API Gateway, prefixos /execution, /os, /management e /billing). Preencha auth0_username e auth0_password antes de rodar. A saga completa (com orcamento e pagamento) esta na collection do OS Service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 - Setup",
      "description": "Token (Auth0 e Lambda), cadastros base na Management e uma OS aberta no OS Service. A Management valida a OS e envia o OrdemServicoValidada ao Execution pela fila SQS. Rodar antes da pasta Execucoes.",
      "item": [
        {
          "name": "Auth0 - Obter Token (ROPC)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "https://{{auth0_domain}}/oauth/token",
              "protocol": "https",
              "host": [
                "{{auth0_domain}}"
              ],
              "path": [
                "oauth",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{auth0_client_id}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{auth0_username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{auth0_password}}",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "openid profile email",
                  "type": "text"
                },
                {
                  "key": "audience",
                  "value": "{{auth0_audience}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Credenciais do usuario de teste do Auth0: preencha auth0_username e auth0_password como valor atual (current value), sem versionar a senha",
                  "if (!pm.variables.get('auth0_username') || !pm.variables.get('auth0_password')) {",
                  "  console.log('auth0_username/auth0_password vazios: preencha as variaveis da collection antes de rodar o Setup.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  var tokenResponse = pm.response.json();",
                  "  pm.test('Retorna access_token', function () {",
                  "    pm.expect(tokenResponse).to.have.property('access_token');",
                  "    pm.expect(tokenResponse.access_token).to.be.a('string').and.not.empty;",
                  "  });",
                  "  pm.collectionVariables.set('auth_access_token', tokenResponse.access_token);",
                  "} else {",
                  "  pm.collectionVariables.unset('auth_access_token');",
                  "  console.log('Falha ao obter token Auth0. Status:', pm.response.code, 'Body:', pm.response.text());",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar Cliente do Token na Management (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Cliente cujo CPF vai na geracao do JWT pela Lambda. O cadastro aceita o token direto do Auth0 (sem cpf)",
                  "function gerarCpfValido() {",
                  "  const base = [];",
                  "  for (let i = 0; i < 9; i++) base.push(Math.floor(Math.random() * 10));",
                  "  let soma = 0;",
                  "  for (let i = 0; i < 9; i++) soma += base[i] * (10 - i);",
                  "  let resto = soma % 11;",
                  "  const d1 = resto < 2 ? 0 : 11 - resto;",
                  "  soma = 0;",
                  "  for (let i = 0; i < 9; i++) soma += base[i] * (11 - i);",
                  "  soma += d1 * 2;",
                  "  resto = soma % 11;",
                  "  const d2 = resto < 2 ? 0 : 11 - resto;",
                  "  return [...base, d1, d2].join('');",
                  "}",
                  "pm.collectionVariables.set('token_cpf', gerarCpfValido());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{managementBaseUrl}}/api/clientes",
              "host": [
                "{{managementBaseUrl}}"
              ],
              "path": [
                "api",
                "clientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeCompleto\": \"Cliente do Token Postman\",\n  \"identificacao\": \"{{token_cpf}}\",\n  \"email\": \"{{auth0_username}}\"\n}"
            }
          }
        },
        {
          "name": "Lambda - Gerar JWT com CPF (200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sem API Gateway (execucao local) nao ha Lambda: a collection segue com o token direto do Auth0",
                  "if (!pm.variables.get('tokenUrl')) {",
                  "  console.log('tokenUrl vazio: geracao do JWT pela Lambda pulada.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  var token = pm.response.json().access_token;",
                  "  pm.test('Retorna access_token', function () { pm.expect(token).to.be.a('string').and.not.empty; });",
                  "  // JWT com a claim cpf: usado em todos os requests seguintes",
                  "  pm.collectionVariables.set('auth_access_token', token);",
                  "} else {",
                  "  console.log('Falha ao gerar o JWT na Lambda. Status:', pm.response.code, 'Body:', pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{tokenUrl}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{auth0_username}}\",\n  \"senha\": \"{{auth0_password}}\",\n  \"cpf\": \"{{token_cpf}}\"\n}"
            }
          }
        },
        {
          "name": "Health - Swagger JSON do Execution (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Content-Type json', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "pm.test('Documenta a fila e as acoes da producao', function () {",
                  "  var caminhos = Object.keys(pm.response.json().paths);",
                  "  pm.expect(caminhos).to.include('/api/execucoes/fila');",
                  "  pm.expect(caminhos).to.include('/api/execucoes/{ordemServicoId}/iniciar-diagnostico');",
                  "  pm.expect(caminhos).to.include('/api/execucoes/{ordemServicoId}/iniciar');",
                  "  pm.expect(caminhos).to.include('/api/execucoes/{ordemServicoId}/finalizar');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
