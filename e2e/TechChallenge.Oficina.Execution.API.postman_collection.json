    {
      "name": "Execucoes",
      "description": "Producao da OS aberta no Setup: entra na fila aguardando diagnostico (OrdemServicoValidada da Management), o mecanico inicia o diagnostico (DiagnosticoIniciado; o OS Service passa a OS para em diagnostico), que aparece na linha do tempo da producao (DynamoDB), e o inicio e a finalizacao da execucao sao rejeitados enquanto o pagamento nao for aprovado. Alem da fila e dos erros 404 e 401. A saga completa (orcamento, pagamento, execucao e finalizacao) esta na collection do OS Service.",
      "item": [
        {
          "name": "01 - Obter Execucao da OS (200, aguardando diagnostico)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// O Execution precisa ter recebido o OrdemServicoValidada da Management",
                  "// A saga e assincrona (filas SQS): espera os outros servicos consumirem os eventos antes da proxima requisicao",
                  "const espera = Number(pm.variables.get('tempo_espera_ms') || 3000);",
                  "setTimeout(function () {}, espera);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "var execucao = pm.response.json();",
                  "pm.test('Execucao da OS', function () { pm.expect(execucao.ordemServicoId).to.eql(pm.collectionVariables.get('os_id')); });",
                  "pm.test('OS recebida (1)', function () { pm.expect(execucao.statusOrdemServico).to.eql(1); });",
                  "pm.test('Etapa aguardando diagnostico (1)', function () { pm.expect(execucao.etapa).to.eql(1); });",
                  "pm.test('Nomes dos servicos da OS', function () { pm.expect(execucao.servicos).to.be.an('array').and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/execucoes/{{os_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "execucoes",
                "{{os_id}}"
              ]
            }
          }
        },
        {
          "name": "02 - Iniciar Diagnostico (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "var execucao = pm.response.json();",
                  "pm.test('Etapa em diagnostico (2)', function () { pm.expect(execucao.etapa).to.eql(2); });",
                  "pm.test('Data do diagnostico registrada', function () { pm.expect(execucao.diagnosticoIniciadoEm).to.be.a('string').and.not.empty; });",
                  "// O status e do OS Service: so muda quando ele consumir o DiagnosticoIniciado e publicar o OrdemServicoStatusAlterado",
                  "pm.test('Status ainda recebida (1)', function () { pm.expect(execucao.statusOrdemServico).to.eql(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/execucoes/{{os_id}}/iniciar-diagnostico",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "execucoes",
                "{{os_id}}",
                "iniciar-diagnostico"
              ]
            }
          }
        },
        {
          "name": "03 - Obter Execucao apos o Diagnostico (200, em diagnostico)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// O OS Service consome o DiagnosticoIniciado (1 -> 2) e o Execution recebe o OrdemServicoStatusAlterado",
                  "// A saga e assincrona (filas SQS): espera os outros servicos consumirem os eventos antes da proxima requisicao",
                  "const espera = Number(pm.variables.get('tempo_espera_ms') || 3000);",
                  "setTimeout(function () {}, espera);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "var execucao = pm.response.json();",
                  "pm.test('OS em diagnostico (2) confirmada pelo OS Service', function () { pm.expect(execucao.statusOrdemServico).to.eql(2); });",
                  "pm.test('Etapa em diagnostico (2)', function () { pm.expect(execucao.etapa).to.eql(2); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/execucoes/{{os_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "execucoes",
                "{{os_id}}"
              ]
            }
          }
        },
        {
          "name": "04 - Obter Historico da Execucao (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Linha do tempo da producao (DynamoDB): o diagnostico iniciado no passo 02 e registrado logo depois da publicacao do evento",
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "var historico = pm.response.json();",
                  "pm.test('Historico e uma lista', function () { pm.expect(historico).to.be.an('array'); });",
                  "pm.test('Todos os eventos sao da OS', function () { historico.forEach(function (evento) { pm.expect(evento.ordemServicoId).to.eql(pm.collectionVariables.get('os_id')); }); });",
                  "var diagnostico = historico.find(function (evento) { return evento.tipo === 'DiagnosticoIniciado'; });",
                  "pm.test('Historico contem o DiagnosticoIniciado', function () { pm.expect(diagnostico, 'DiagnosticoIniciado na linha do tempo').to.be.an('object'); });",
                  "pm.test('Diagnostico registrado pela acao do mecanico, sem repeticao', function () { pm.expect(diagnostico && diagnostico.origem).to.eql('acao'); pm.expect(diagnostico && diagnostico.repeticao).to.eql(false); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/execucoes/{{os_id}}/historico",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "execucoes",
                "{{os_id}}",
                "historico"
              ]
            }
          }
        },
        {
          "name": "05 - Iniciar Execucao sem Pagamento (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
